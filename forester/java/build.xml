<?xml version="1.0" encoding="ISO-8859-1"?>
<project name="FORESTER" basedir="." default="all">

    <property name="src.dir" value="src"/>
    <property name="classes.dir" value="classes"/>
    <property name="jars.dir" value="resources"/>
    <property name="openpdfjar" value="${jars.dir}/openpdf-1.3.35.jar"/>
    <property name="commonscodecjar" value="${jars.dir}/commons-codec-1.5.jar"/>
    <property name="openchartjar" value="${jars.dir}/openchart.jar"/>
    <property name="flatlafjar" value="${jars.dir}/flatlaf-3.7.1.jar"/>
    <property name="vectorgraphics2djar" value="${jars.dir}/VectorGraphics2D-0.13.jar"/>
    <property name="forester_jar" value="forester.jar"/>
    <property name="forester.source.revision" value="unknown"/>

    <target name="source-revision" description="Validate the source commit used for packaging">
        <fail message="Pass -Dforester.source.revision=&lt;full Git commit&gt; for the source being built.">
            <condition>
                <not>
                    <matches string="${forester.source.revision}" pattern="^[0-9a-f]{40}$"/>
                </not>
            </condition>
        </fail>
    </target>

    <target name="clean" description="Delete all generated files">
        <delete dir="${classes.dir}" failonerror="false"/>
        <delete file="${forester_jar}"/>
    </target>

    <target name="copy_resources" description="Copies resources">
        <mkdir dir="${classes.dir}/resources"/>
        <copy verbose="true"
              file="../resources/phyloxml_schema/1.20/phyloxml.xsd"
              todir="${classes.dir}/resources"/>
        <mkdir dir="${classes.dir}/resources/fonts"/>
        <copy todir="${classes.dir}/resources/fonts">
            <fileset dir="../resources/fonts" includes="*.ttf,LICENSE*,*.md,*.txt"/>
        </copy>
        <mkdir dir="${classes.dir}/resources/images"/>
        <copy todir="${classes.dir}/resources/images">
            <fileset dir="../resources/images" includes="*.png"/>
        </copy>
        <!-- bundle ONLY the curated demo-gallery resources into the jar so File -> Demo Trees works from any install
             (keep this list in sync with DemoTrees.catalog(); DemoTreesGalleryTest fails if one is missing) -->
        <mkdir dir="${classes.dir}/resources/demo"/>
        <copy todir="${classes.dir}/resources/demo">
            <fileset dir="../demo" includes="color-by-property.xml,tree-properties.xml,annotation-columns.xml,symbol-columns.xml,label-properties.xml,stacked-bar-columns.xml,domain-architectures.xml,alignment.xml,bat-phylogeny.xml,animal-tree-of-life.xml,ancestral-pie-charts.xml,node-hpd-bars.xml,long-branch-break.xml,sars-cov-2-time-tree.xml,nextstrain-ncov.json,filoviridae-tree.xml,dinosaur-time-tree.xml,late-cretaceous-stages.xml,lagomorph-time-tree.xml,ammonite-time-tree.xml,tree-of-life-deep-time.xml,tanglegram-host-tree.xml,tanglegram-parasite-tree.xml,tanglegram-association.tsv,gtdb-genomes.xml,gtdb-classifications.tsv,pangenome-presence-absence.xml,pangenome-presence-absence.tsv,sparse-accessory-genome.xml,sparse-accessory-genome.tsv"/>
        </copy>
    </target>

    <target name="compile" description="Compiles the Task" depends="clean,copy_resources">
        <mkdir dir="${classes.dir}"/>
        <javac release="11" debug="true" debuglevel="lines,source" srcdir="${src.dir}"
               destdir="${classes.dir}" optimize="on" verbose="false" encoding="UTF-8"
               includeantruntime="false"
               classpath="${openpdfjar};${commonscodecjar};${openchartjar};${flatlafjar};${vectorgraphics2djar}">
            <compilerarg value="-Xlint:deprecation"/>
            <compilerarg value="-Xlint:unchecked"/>
        </javac>
    </target>

    <target name="bundle-flatlaf" depends="compile" unless="forester.host.provides.flatlaf">
        <unjar src="${flatlafjar}" dest="${classes.dir}">
            <patternset>
                <include name="**/*.class"/>
                <include name="**/*.properties"/>
                <include name="com/formdev/flatlaf/natives/**"/>
                <exclude name="module-info.class"/>
                <!-- FlatLaf's TitleBarCaptionHitTest is a runtime class. -->
            </patternset>
        </unjar>
    </target>

    <target name="jar" description="JARs the classes files" depends="compile,copy_resources,bundle-flatlaf">
        <unjar src="${openpdfjar}" dest="${classes.dir}">
            <patternset>
                <include name="**/*.class"/>
                <include name="**/*.afm"/>
                <include name="**/*.cmap"/>
                <include name="**/*.properties"/>
                <include name="**/*.txt"/>
                <exclude name="module-info.class"/>
            </patternset>
        </unjar>
        <unjar src="${commonscodecjar}" dest="${classes.dir}">
            <patternset>
                <include name="**/*.class"/>
                <exclude name="**/*Test*.class"/>
            </patternset>
        </unjar>
        <unjar src="${openchartjar}" dest="${classes.dir}">
            <patternset>
                <include name="**/*.class"/>
                <exclude name="**/*Test*.class"/>
            </patternset>
        </unjar>
        <unjar src="${vectorgraphics2djar}" dest="${classes.dir}">
            <patternset>
                <include name="**/*.class"/>
            </patternset>
        </unjar>
        <!-- keep test-only classes out of the shipped jar; spelled out by name rather than a
             *Test* wildcard, which would also strip FlatLaf's legitimate ...$TitleBarCaptionHitTest -->
        <jar level="9" destfile="${forester_jar}" basedir="${classes.dir}" excludes="**/Embedded*Test*.class,**/TypomaticButtonCloseTest*.class,**/PartitionLineRenderTest*.class,**/Test.class,**/PropertyColorSchemeTest*.class,**/TreePanelUtilTest*.class,**/BranchLengthLayoutTest*.class,**/AptxUtilTest*.class,**/ConfigurationTest*.class,**/SettingsDialogTest*.class,**/TabContextMenuTest*.class,**/SubSuperTreeButtonsTest*.class,**/MenuTooltipsTest*.class,**/ConfidenceRenderTest*.class,**/CollapsedCladeConfidenceTest*.class,**/MinConfidenceFractionRenderTest*.class,**/TreePropertiesEditTest*.class,**/ShowTreeNameRenderTest*.class,**/ViewportScrollModeTest*.class,**/MadSupportClearedTest*.class,**/RerootingTest*.class,**/RootingGuardsTest*.class,**/LegendDragTest*.class,**/LegendClickDragTest*.class,**/PanOnPressTest*.class,**/MenuAcceleratorTest*.class,**/ImageSelectionTest*.class,**/ClipboardImageTest*.class,**/GuiPreferencesTest*.class,**/ExportBackgroundTest*.class,**/ConfidenceLabelTest*.class,**/PropertyLegendBarTest*.class,**/LegendPlacementTest*.class,**/ConnectorColorTest*.class,**/FoundBranchExportTest*.class,**/SequenceAndTaxonomyDataObtainerTest*.class,**/LabelDataExtractorTest*.class,**/TipDateExtractorTest*.class,**/HeightDateConverterTest*.class,**/BranchLengthDateConverterTest*.class,**/LabelDateAnchorTest*.class,**/TipDateToolTest*.class,**/TimeOverlayUxTest*.class,**/TriangularNudgeTest*.class,**/NodeDataExporterTest*.class,**/NodeDataImporterTest*.class,**/PhylogenyPropertyRoundTripTest*.class,**/ExternalNodeDeletionTest*.class,**/TreeAppPropertyTest*.class,**/GtdbTaxonomyTest*.class,**/ImportGtdbToolTest*.class,**/RepresentativeTipSelectorTest*.class,**/RepresentativeTipsToolTest*.class,**/AnnotationColumnsTest*.class,**/AnnotationColumnsToolTest*.class,**/LabelPropertiesTest*.class,**/PropertiesListTest*.class,**/PangenomeContractTest*.class,**/MatrixColumnOrderTest*.class,**/MatrixColumnOrderMenuTest*.class,**/AnnotationColumnDragTest*.class,**/TipImageTest*.class,**/TipImageRenderTest*.class,**/NodeDataDraftTest*.class,**/NodeDataFormTest*.class,**/NodeFrameTest*.class,**/NodeWindowRebindTest*.class,**/VisualizationLifecycleTest*.class,**/DomainPaletteTest*.class,**/RenderableDomainArchitectureTest*.class,**/DomainLegendOrderTest*.class,**/DomainRadialWidthTest*.class,**/NodeHoverCardTest*.class,**/UpdateCheckTest*.class,**/TreePropertiesDraftTest*.class,**/TreeFactsTest*.class,**/TreeTextTest*.class,**/FormWidgetsTest*.class,**/TreePropertiesFormTest*.class,**/TreeWindowsTest*.class,**/ClickToOrderTest*.class,**/MsaColorsTest*.class,**/ResidueInfoTest*.class,**/MsaHitTestTest*.class,**/CladeBandStaleNodeTest*.class,**/ErrorLogTest*.class,**/TaxonomyIdProviderTest*.class,**/PerTabDisplayStateTest*.class,**/TestFail*.class,**/FigureSpecTest*.class,**/MsaConservationTest*.class,**/ChromeColorsTest*.class,**/NodePopupLifecycleTest*.class,**/RecentFilesTest*.class,**/AlignmentImporterTest*.class,**/MsaTrackRenderTest*.class,**/SymbolColumnRenderTest*.class,**/ImportAnnotationsToolTest*.class,**/TreeHistoryTest*.class,**/UndoRedoToolTest*.class,**/LegendControlsToolTest*.class,**/NodeSelectionToolTest*.class,**/LabelExtractionResizeTest*.class,**/ControlPanelBorderTest*.class,**/AlgorithmReferencesTest*.class,**/SearchMatchingTest*.class,**/SearchToolTest*.class,**/SearchAutocompleteTest*.class,**/FoundSelectedCounterTest*.class,**/NodeStyleEditorTest*.class,**/NodeStyleDialogTest*.class,**/TimeTreeLabelTest*.class,**/GeologicTimeScaleTest*.class,**/TimeAxisConfigTest*.class,**/ExternalDataFitTest*.class,**/VectorGraphicsExporterTest*.class,**/LabelAdvanceWidthTest*.class,**/NodeSupportSymbolTest*.class,**/RankLegendTest*.class,**/CollapsedCladeTest*.class,**/CollapsedCladeRenderTest*.class,**/InternalTaxaKeyRenderTest*.class,**/InternalLabelPlacementTest*.class,**/InternalTaxonomyDedupTest*.class,**/ItalicScientificNamesTest*.class,**/ExportResolutionTest*.class,**/ExportSizeSpecTest*.class,**/FixedExportSizeTest*.class,**/TaxonomySpeciesTreeBuilderTest*.class,**/TaxonomyReconciliationTest*.class,**/CollapseMenuFontTest*.class,**/DisplayDataCheckboxTest*.class,**/NcbiTaxonomyLineageServiceTest*.class,**/TaxonLineageTest*.class,**/AncestralTaxonomyInferenceTest*.class,**/BeastAnnotationParserTest*.class,**/NexusTaxlabelAnnotationTest*.class,**/BracketAnnotationNormalizerTest*.class,**/ParserUtilsTest*.class,**/UniProtKbClientTest*.class,**/AccessionAwareLineageServiceTest*.class,**/NcbiSequenceClientTest*.class,**/SequenceTaxonomyResolverTest*.class,**/TaxonomyDiskCacheTest*.class,**/FontResourcesTest*.class,**/FontSizeControlTest*.class,**/TreeColorSchemeTest*.class,**/TaxonomyNodeLabelOverlapTest*.class,**/ColorPaletteDefaultTest*.class,**/KeyboardShortcutsTest*.class,**/ResetToDefaultsTest*.class,**/PropertySizeScaleTest*.class,**/DemoTreesTest*.class,**/demo/DemoTreeGenerator*.class,**/demo/AuspiceDemoGenerator*.class,**/ScaleAxisRenderTest*.class,**/GeologicAxisRenderTest*.class,**/TimeAxisPerTreeTest*.class,**/HpdBarRenderTest*.class,**/FossilRangeBarRenderTest*.class,**/DemoTreesGalleryTest*.class,**/JsonParserTest*.class,**/AuspiceJsonParserTest*.class,**/NextstrainBranchModeTest*.class,**/FileFilterTest*.class,**/AncestralPieRenderTest*.class,**/RadialNodeContentRenderTest*.class,**/RadialInteractionTest*.class,**/RadialZoomControlTest*.class,**/OrderButtonToggleTest*.class,**/EqualizerIconTest*.class,**/ThemeToggleIconTest*.class,**/TreeGlyphIconTest*.class,**/CladeLevelTest*.class,**/CladeHuePaletteTest*.class,**/CladeLegendSectionsTest*.class,**/CladeLevelsRenderTest*.class,**/LayoutButtonsTest*.class,**/PerTabViewStateTest*.class,**/ControlButtonIconTest*.class,**/MalformedDomainTest*.class,**/FocusGlowRenderTest*.class,**/AptxRenderTest*.class,**/ProcessMenuAnimationTest*.class,**/TanglegramLinkerTest*.class,**/TanglegramAssociationTest*.class,**/TanglegramPanelRenderTest*.class,**/TanglegramToolTest*.class,**/TanglegramUntanglerTest*.class,**/TanglegramColoringTest*.class,**/TanglegramExporterTest*.class,**/ZebraStripeRenderTest*.class,**/BreakLongBranchRenderTest*.class,**/DomainArchitectureVerticalRenderTest*.class,**/DomainRenderTest*.class,**/DomainSubtreeFitTest*.class,**/DomainTreeZoomTest*.class,**/DomainLabelStyleTest*.class,**/MatrixDendrogramRenderTest*.class,**/AnnotationCellHoverTest*.class,**/LegendColumnTest*.class,**/ClustergramRenderTest*.class,**/ClustergramPresetTest*.class,**/HeatmapMatrixRenderTest*.class,**/ReverseTipOrderRenderTest*.class,**/OrientationRenderTest*.class,**/OrientationZoomControlTest*.class,**/OrientationOverviewTest*.class,**/SearchEmphasisRenderTest*.class,**/PulseFoundNodesRenderTest*.class,**/SearchStepThroughTest*.class,**/DirectoryPreferencesTest*.class,**/PersistentDirectoriesTest*.class,**/AboutDialogTest*.class,**/TreeStyleRemovalTest*.class" duplicate="fail"
             index="true">
            <manifest>
                <attribute name="Main-Class" value="org.forester.archaeopteryx.Archaeopteryx"/>
                <attribute name="Forester-Source-Revision" value="${forester.source.revision}"/>
            </manifest>
        </jar>
    </target>

    <target name="jalview-jar" depends="source-revision"
            description="Build Forester with FlatLaf supplied by the host">
        <antcall target="jar">
            <param name="forester.host.provides.flatlaf" value="true"/>
        </antcall>
    </target>

    <target name="jalview-artifacts" depends="source-revision,jalview-jar,jalviewjs-site"
            description="Build both Jalview artifacts from the recorded source revision"/>

    <target name="jalviewjs-site" description="Package the Eclipse Java2Script output for JalviewJS"
            depends="source-revision,copy_resources">
        <available file="../build/jalviewjs/swingjs/j2s/org/forester/archaeopteryx/TreePanel.js"
                   property="jalviewjs.compiled"/>
        <fail unless="jalviewjs.compiled" message="Transpile the forester Eclipse project before packaging JalviewJS."/>
        <echo file="../build/jalviewjs/swingjs/j2s/resources/forester-source.properties"
              encoding="UTF-8">forester.source.revision=${forester.source.revision}${line.separator}</echo>
        <zip destfile="../build/forester-site.zip" level="9">
            <fileset dir="../build/jalviewjs">
                <include name="swingjs/j2s/org/forester/**/*.js"/>
                <exclude name="**/*Test*.js"/>
                <exclude name="swingjs/j2s/org/forester/test/**"/>
                <include name="swingjs/j2s/resources/forester-source.properties"/>
            </fileset>
            <zipfileset dir="${classes.dir}" prefix="swingjs/j2s">
                <include name="resources/phyloxml.xsd"/>
                <include name="resources/fonts/**"/>
                <include name="resources/images/**"/>
                <include name="resources/demo/**"/>
            </zipfileset>
        </zip>
    </target>

    <target name="test-embedded" depends="compile"
            description="Run embedding and affected window regressions (requires a display or xvfb-run)">
        <macrodef name="run-embedded-test">
            <attribute name="class"/>
            <sequential>
                <java classname="org.forester.archaeopteryx.@{class}" fork="true" dir="${basedir}/../.."
                      failonerror="true" timeout="120000">
                    <classpath>
                        <pathelement location="${classes.dir}"/>
                        <pathelement location="${flatlafjar}"/>
                        <fileset dir="${jars.dir}" includes="*.jar"/>
                    </classpath>
                </java>
            </sequential>
        </macrodef>
        <run-embedded-test class="EmbeddedDefaultsTest"/>
        <run-embedded-test class="EmbeddedNodeDialogTest"/>
        <run-embedded-test class="EmbeddedLabelHitTest"/>
        <run-embedded-test class="EmbeddedTreeLifecycleTest"/>
        <run-embedded-test class="EmbeddedWindowLifecycleTest"/>
        <run-embedded-test class="TypomaticButtonCloseTest"/>
        <run-embedded-test class="EmbeddedWorkerCloseTest"/>
        <run-embedded-test class="PartitionLineRenderTest"/>
        <run-embedded-test class="DomainLabelStyleTest"/>
        <run-embedded-test class="RootingGuardsTest"/>
        <run-embedded-test class="SubSuperTreeButtonsTest"/>
        <run-embedded-test class="CladeLegendSectionsTest"/>
        <run-embedded-test class="CladeLevelsRenderTest"/>
        <run-embedded-test class="ControlPanelBorderTest"/>
        <run-embedded-test class="LayoutButtonsTest"/>
        <run-embedded-test class="PerTabViewStateTest"/>
        <run-embedded-test class="DomainTreeZoomTest"/>
    </target>

    <target name="all" description="" depends="jar">
    </target>

    <!-- ================= Native packaging (jpackage) =================
         Builds a self-contained Archaeopteryx.app / .dmg with a bundled JRE from the fat forester.jar.
         jpackage produces installers only for the HOST OS, so these mac targets must run on macOS;
         Windows (.msi/.exe) and Linux (.deb/.rpm) are built by the same recipe on those platforms.
         Output goes to dist/ (git-ignored). Requires a JDK (jpackage); run with JAVA_HOME pointing at a JDK. -->
    <property name="app.name" value="Archaeopteryx"/>
    <property name="app.vendor" value="Christian M. Zmasek"/>
    <property name="app.copyright" value="Copyright (C) 2026 Christian M. Zmasek"/>
    <property name="app.mainclass" value="org.forester.archaeopteryx.Archaeopteryx"/>
    <property name="app.identifier" value="org.forester.archaeopteryx"/>
    <property name="dist.dir" value="dist"/>
    <property name="jpackage.input.dir" value="${dist.dir}/jpackage-input"/>
    <property name="jpackage" value="${java.home}/bin/jpackage"/>
    <!-- platform app icon (repo-root archaeopteryx_icon_assets/, relative to this basedir forester/java) -->
    <property name="mac.icon" value="../../archaeopteryx_icon_assets/Archaeopteryx.icns"/>

    <!-- Single source of truth for the version: parsed out of AptxConstants.java so there is nothing to keep
         in sync. macOS/Windows reject a leading-zero major, so the bundle's CFBundleVersion strips a leading
         "0." (0.9.82 -> 9.82, still correctly ordered through 0.9.x/0.10.x); the true, user-visible version is
         restored into CFBundleShortVersionString and the .dmg filename below. -->
    <target name="-app-version">
        <exec executable="/bin/sh" outputproperty="app.version" failonerror="true">
            <arg value="-c"/>
            <arg value="grep 'VERSION =' ${src.dir}/org/forester/archaeopteryx/AptxConstants.java | head -1 | sed -E 's/.*&quot;([^&quot;]+)&quot;.*/\1/'"/>
        </exec>
        <exec executable="/bin/sh" outputproperty="app.version.bundle" failonerror="true">
            <arg value="-c"/>
            <arg value="echo '${app.version}' | sed -E 's/^0\.//'"/>
        </exec>
        <echo message="Archaeopteryx ${app.version} (macOS CFBundleVersion ${app.version.bundle})"/>
    </target>

    <target name="jpackage-app-image" depends="all,-app-version"
            description="Build the self-contained macOS Archaeopteryx.app (bundled JRE)">
        <delete dir="${dist.dir}/${app.name}.app" failonerror="false"/>
        <delete dir="${jpackage.input.dir}" failonerror="false"/>
        <mkdir dir="${jpackage.input.dir}"/>
        <!-- jpackage adds every jar in the input dir to the classpath; stage only the fat jar so nothing leaks in -->
        <copy file="${forester_jar}" todir="${jpackage.input.dir}"/>
        <mkdir dir="${dist.dir}"/>
        <exec executable="${jpackage}" failonerror="true">
            <arg value="--type"/>                   <arg value="app-image"/>
            <arg value="--name"/>                   <arg value="${app.name}"/>
            <arg value="--app-version"/>            <arg value="${app.version.bundle}"/>
            <arg value="--vendor"/>                 <arg value="${app.vendor}"/>
            <arg value="--copyright"/>              <arg value="${app.copyright}"/>
            <arg value="--input"/>                  <arg value="${jpackage.input.dir}"/>
            <arg value="--main-jar"/>               <arg value="${forester_jar}"/>
            <arg value="--main-class"/>             <arg value="${app.mainclass}"/>
            <arg value="--icon"/>                   <arg value="${mac.icon}"/>
            <arg value="--java-options"/>           <arg value="-Xmx2g"/>
            <arg value="--java-options"/>           <arg value="-Dapple.laf.useScreenMenuBar=true"/>
            <arg value="--mac-package-identifier"/> <arg value="${app.identifier}"/>
            <arg value="--dest"/>                   <arg value="${dist.dir}"/>
        </exec>
        <!-- show the true 0.9.x version in Finder > Get Info (jpackage set the stripped bundle version for both) -->
        <exec executable="/usr/libexec/PlistBuddy" failonerror="true">
            <arg value="-c"/>
            <arg value="Set :CFBundleShortVersionString ${app.version}"/>
            <arg value="${dist.dir}/${app.name}.app/Contents/Info.plist"/>
        </exec>
        <echo message="Built ${dist.dir}/${app.name}.app (version ${app.version})"/>
    </target>

    <target name="jpackage-dmg" depends="jpackage-app-image"
            description="Wrap Archaeopteryx.app into a distributable macOS .dmg">
        <delete verbose="true">
            <fileset dir="${dist.dir}" includes="${app.name}-*.dmg"/>
        </delete>
        <exec executable="${jpackage}" failonerror="true">
            <arg value="--type"/>        <arg value="dmg"/>
            <arg value="--name"/>        <arg value="${app.name}"/>
            <arg value="--app-version"/> <arg value="${app.version.bundle}"/>
            <arg value="--vendor"/>      <arg value="${app.vendor}"/>
            <arg value="--copyright"/>   <arg value="${app.copyright}"/>
            <arg value="--app-image"/>   <arg value="${dist.dir}/${app.name}.app"/>
            <arg value="--dest"/>        <arg value="${dist.dir}"/>
        </exec>
        <!-- jpackage names it <app>-<bundleversion>.dmg; rename to the real version for a clean download name -->
        <move file="${dist.dir}/${app.name}-${app.version.bundle}.dmg"
              tofile="${dist.dir}/${app.name}-${app.version}.dmg" failonerror="false"/>
        <echo message="Built ${dist.dir}/${app.name}-${app.version}.dmg"/>
    </target>

</project>
